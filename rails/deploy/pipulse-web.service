[Unit]
Description=PiPulse web dashboard
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/pi-pulse/rails
EnvironmentFile=/etc/pipulse.env
Environment=PATH=/home/pi/.rbenv/shims:/home/pi/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pi/pi-pulse/rails/bin/rails server --binding 0.0.0.0
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/pi-pulse/rails/log /home/pi/pi-pulse/rails/storage /home/pi/pi-pulse/rails/tmp

[Install]
WantedBy=multi-user.target
